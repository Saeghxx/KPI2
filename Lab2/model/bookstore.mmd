
```mermaid
erDiagram
    Customer {
        UUID id PK
        varchar email UK
        varchar full_name
        varchar password_hash
        varchar role
        varchar phone
        varchar address
    }

    Publisher {
        UUID id PK
        varchar name
    }

    Author {
        UUID id PK
        varchar full_name
    }

    Category {
        UUID id PK
        varchar name
    }

    Book {
        UUID id PK
        UUID publisher_id FK
        varchar isbn UK
        varchar title
        int publication_year
        decimal price
    }

    CustomerOrder {
        UUID id PK
        UUID customer_id FK
        varchar status
        timestamp created_at
    }

    OrderItem {
        UUID id PK
        UUID order_id FK
        UUID book_id FK
        int quantity
        decimal unit_price
    }

    Review {
        UUID id PK
        UUID customer_id FK
        UUID book_id FK
        int rating
        varchar comment
        timestamp created_at
    }

    Payment {
        UUID id PK
        UUID order_id FK
        varchar transaction_id UK
        varchar payment_status
        decimal amount
    }

    Shipment {
        UUID id PK
        UUID order_id FK
        varchar shipment_id UK
    }

    Publisher ||--o{ Book : publishes
    Author }o--|{ Book : writes
    Category }o--o{ Book : classifies
    Customer }o--o{ Book : wishlist
    Customer ||--o{ CustomerOrder : places
    CustomerOrder ||--|{ OrderItem : contains
    Book ||--o{ OrderItem : ordered_as
    Customer ||--o{ Review : writes
    Book ||--o{ Review : receives
    CustomerOrder ||--o{ Payment : paid_by
    CustomerOrder ||--o| Shipment : shipped_as

