@startuml
left to right direction
skinparam packageStyle rectangle

actor "Гість" as Guest
actor "Покупець" as Buyer
actor "Адміністратор" as Admin
actor "Платіжний шлюз" as PaymentGateway <<система>>
actor "Служба доставки" as DeliveryService <<система>>

Buyer --|> Guest

rectangle "Онлайн-книгарня" {
  usecase "UC-01 Пошук книг" as UC01
  usecase "UC-02 Реєстрація" as UC02
  usecase "UC-03 Керування кошиком" as UC03
  usecase "UC-04 Оформлення замовлення" as UC04
  usecase "UC-05 Перевірка кошика" as UC05
  usecase "UC-06 Оплата замовлення" as UC06
  usecase "UC-07 Перевірка результату оплати" as UC07
  usecase "UC-08 Обробка відмови\nабо таймауту оплати" as UC08
  usecase "UC-09 Передавання замовлення\nна доставку" as UC09
  usecase "UC-10 Скасування замовлення" as UC10
  usecase "UC-11 Залишення відгуку" as UC11
  usecase "UC-12 Керувати каталогом\n(абстрактний)" as UC12
  usecase "UC-13 Створити книгу" as UC13
  usecase "UC-14 Редагувати книгу" as UC14
}

Guest --> UC01
Guest --> UC02

Buyer --> UC03
Buyer --> UC04
Buyer --> UC06
Buyer --> UC10
Buyer --> UC11

Admin --> UC12

PaymentGateway --> UC06
PaymentGateway --> UC07
DeliveryService --> UC09

UC04 ..> UC05 : <<include>>
UC06 ..> UC07 : <<include>>
UC08 ..> UC06 : <<extend>>

UC13 --|> UC12
UC14 --|> UC12
@enduml