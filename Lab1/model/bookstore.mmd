erDiagram
    CUSTOMER {
        UUID id PK
        string email
        string full_name
    }
    PUBLISHER {
        UUID id PK
        string name
    }
    AUTHOR {
        UUID id PK
        string full_name
    }
    CATEGORY {
        UUID id PK
        string name
    }
    BOOK {
        UUID id PK
        UUID publisher_id FK
        string isbn
        string title
        int publication_year
        decimal price
    }
    CUSTOMER_ORDER {
        UUID id PK
        UUID customer_id FK
        string status
        timestamp created_at
        decimal total_price
    }
    REVIEW {
        UUID id PK
        UUID customer_id FK
        UUID book_id FK
        int rating
        string comment
        timestamp created_at
    }

    PUBLISHER ||--o{ BOOK : publishes
    AUTHOR }o--o{ BOOK : writes
    CATEGORY }o--o{ BOOK : classifies
    CUSTOMER }o--o{ BOOK : wishlists
    CUSTOMER ||--o{ CUSTOMER_ORDER : places
    CUSTOMER ||--o{ REVIEW : writes
    CUSTOMER_ORDER }o--o{ BOOK : contains
    BOOK ||--o{ REVIEW : "reviewed in"
